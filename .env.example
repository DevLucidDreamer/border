# BORDER API 키 설정 예시 — 이 파일을 복사해 `.env`로 만든 뒤 값을 채우세요.
#   cp .env.example .env

# Claude (정리·퀴즈·전략) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (Whisper STT + gpt-4o-mini-tts TTS, 키 하나로 둘 다) — https://platform.openai.com
OPENAI_API_KEY=

# 시간표 OCR은 위 ANTHROPIC_API_KEY(Claude 비전)를 그대로 씁니다. 별도 키가 필요 없어요.
# 굳이 Gemini로 바꾸고 싶을 때만 아래 주석을 풀고 값을 채우세요(선택).
# GEMINI_API_KEY=

# 선택: 모델을 바꾸고 싶을 때만. 비워두면 기본값 사용.
# CLAUDE_MODEL=claude-sonnet-5
# STT_MODEL=whisper-1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral
